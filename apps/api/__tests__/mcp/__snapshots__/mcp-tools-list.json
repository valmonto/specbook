  {
    "name": "update_status",
    "description": "Move a task through the agent transitions: in_progress → blocked (comment = your question, required) or → needs_review (requires a summary comment AND branch + prUrl set on the task first, via update_task_links); blocked/changes_requested → in_progress to resume. One recovery edge: cancelled → done, for a completed no-code/research task the human cancelled that has no PR to reach done through review (the only → done an agent may make; the review path stays the human's).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "to": {
          "type": "string",
          "enum": [
            "draft",
            "ready",
            "in_progress",
            "blocked",
            "needs_review",
            "approved",
            "changes_requested",
            "done",
            "cancelled"
          ]
        },
        "comment": {
          "type": "string"
        },
        "costTokensIn": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "costTokensOut": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "costUsdCents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "to"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "update_task",
    "description": "Edit a task's spec you captured — title, context, out-of-scope, area, acceptance criteria — on a DRAFT task, or an in_progress task you've claimed. Cannot change status, ownership, priority, or PR/branch links (use the transition / update_task_links tools). Org-scoped — the repair for a mistyped create_task.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "context": {
          "type": "string"
        },
        "outOfScope": {
          "type": "string"
        },
        "area": {
          "type": "string",
          "maxLength": 120
        },
        "acceptanceCriteria": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "update_task_links",
    "description": "Record where the work lives: branch name and PR URL. Required before update_status → needs_review.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "branch": {
          "type": "string",
          "maxLength": 255
        },
        "prUrl": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": [
        "id"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "whoami",
    "description": "This API key: its name and the scopes it was granted.",
    "inputSchema": {
      "type": "object",
      "properties": {}
    }
  }
]
