# Local dev with `docker compose -f compose.dev.yml up` (Postgres, Redis, rustfs).
# Usage: cp .env.example .env && source .env
# Everything else has a working dev default in apps/{api,worker}/src/config/env.schema.ts.

# Postgres from compose.dev.yml
export DATABASE_URL=postgresql://specbook:specbook@127.0.0.1:5432/specbook

# Redis from compose.dev.yml (--requirepass specbook); sessions and job queues
export IAM_REDIS_PASSWORD=specbook
export REDIS_PASSWORD=specbook

# Auth secrets — required, min 32 chars. Generate: openssl rand -hex 32
export IAM_JWT_SECRET=dev-jwt-secret-change-me-at-least-32-characters
export IAM_COOKIE_SECRET=dev-cookie-secret-change-me-at-least-32-characters

# Seals server SSH keys and environment secrets in the database — required by
# both the api and the worker. Must decode to exactly 32 bytes.
# Generate: openssl rand -base64 32
export APP_ENCRYPTION_KEY=ZGV2LW9ubHktcGxhY2Vob2xkZXIta2V5LTMyYnl0ZXM=

# Seed login (defaults to admin@valmonto.com / ChangeMe123! if unset)
export SEED_ON_STARTUP=true

# Object storage — the rustfs block in compose.dev.yml already matches the
# schema defaults (http://localhost:9000, specbook/specbook), so these are only
# needed when you point at a different endpoint.
# export STORAGE_ENDPOINT=http://localhost:9000
# export STORAGE_ACCESS_KEY_ID=specbook
# export STORAGE_SECRET_ACCESS_KEY=specbook
# export STORAGE_BUCKET=specbook-attachments

# GitHub App — optional and all-or-nothing; absent means the GitHub connection
# reports "not configured" and auto modes never merge. The private key is a PEM
# or a base64-encoded PEM.
# export GITHUB_APP_ID=
# export GITHUB_APP_SLUG=
# export GITHUB_APP_PRIVATE_KEY=
# export GITHUB_WEBHOOK_SECRET=

# Telemetry — optional, absent means no-op.
# export SENTRY_DSN=
# export POSTHOG_KEY=

# Mobile (Expo) — the phone can't reach "localhost"; use this machine's LAN IP.
# Find it with: ip -4 -br addr show
export EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:3000
